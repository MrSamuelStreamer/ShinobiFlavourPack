<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Champion"]/apparelRequired</xpath>
        <value>
            <apparelRequired Inherit="False">
                <li>KRC_ReindeerCaptainHelmet</li>
                <li>KRC_ReindeerCaptainArmor</li>
                <li>KRC_RcFatigues</li>
            </apparelRequired>
        </value>
    </Operation>

    <!-- Override inherited fighter tags / undershirt rules so extra Royalty gear is not rolled. -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Champion"]</xpath>
        <value>
            <apparelTags Inherit="False" />
            <specificApparelRequirements Inherit="False" />
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Champion"]/weaponTags</xpath>
        <value>
            <li>RCorpMelee</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Champion"]/apparelColor</xpath>
        <value>
            <apparelColor>(39,36,31)</apparelColor>
        </value>
    </Operation>
</Patch>
