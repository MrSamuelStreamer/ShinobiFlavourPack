<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_StellicGuardMelee"]/apparelRequired</xpath>
        <value>
            <apparelRequired Inherit="False">
                <li>KRC_RhinoCaptainArmor</li>
                <li>KRC_RhinoCaptainHelmet</li>
                <li>KRC_RcFatigues</li>
            </apparelRequired>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_StellicGuardMelee"]</xpath>
        <value>
            <apparelTags Inherit="False" />
            <specificApparelRequirements Inherit="False" />
            <apparelColor>(39,36,31)</apparelColor>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_StellicGuardMelee"]/weaponTags</xpath>
        <value>
            <li>RCorpMelee</li>
        </value>
    </Operation>

    <!-- Ranged child has no apparelRequired; prestige cataphract lives on StellicGuardBase. -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_StellicGuardRanged"]</xpath>
        <value>
            <apparelRequired Inherit="False">
                <li>KRC_RhinoCaptainArmor</li>
                <li>KRC_RhinoCaptainHelmet</li>
                <li>KRC_RcFatigues</li>
            </apparelRequired>
            <apparelTags Inherit="False" />
            <specificApparelRequirements Inherit="False" />
            <apparelColor>(39,36,31)</apparelColor>
        </value>
    </Operation>
</Patch>
