<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Empire_Royal_Bestower"]/apparelRequired</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Empire_Royal_Bestower"]/apparelRequired</xpath>
      <value>
        <apparelRequired>
          <li>KRC_CommanderOvercoat</li>
          <li>KRC_CommanderCoat</li>
          <li>KRC_CommanderBeret</li>
          <li>KRC_RcTurtleneck</li>
        </apparelRequired>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Empire_Royal_Bestower"]</xpath>
      <value>
        <apparelRequired>
          <li>KRC_CommanderOvercoat</li>
          <li>KRC_CommanderCoat</li>
          <li>KRC_CommanderBeret</li>
          <li>KRC_RcTurtleneck</li>
        </apparelRequired>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Empire_Royal_Bestower"]/apparelColor</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Empire_Royal_Bestower"]/apparelColor</xpath>
      <value>
        <apparelColor>(39,36,31)</apparelColor>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Empire_Royal_Bestower"]</xpath>
      <value>
        <apparelColor>(39,36,31)</apparelColor>
      </value>
    </nomatch>
  </Operation>

</Patch>