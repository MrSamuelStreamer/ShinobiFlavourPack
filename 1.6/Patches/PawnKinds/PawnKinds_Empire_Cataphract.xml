<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]/apparelRequired</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]/apparelRequired</xpath>
      <value>
        <apparelRequired>
          <li>KRC_RhinoArmor</li>
          <li>KRC_RhinoHelmetTypeA</li>
          <li>KRC_RcFatigues</li>
        </apparelRequired>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]</xpath>
      <value>
        <apparelRequired>
          <li>KRC_RhinoArmor</li>
          <li>KRC_RhinoHelmetTypeA</li>
          <li>KRC_RcFatigues</li>
        </apparelRequired>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]/weaponTags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]/weaponTags</xpath>
        <value>
          <li>RCorpMelee</li>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]</xpath>
        <value>
          <weaponTags>
            <li>RCorpMelee</li>
          </weaponTags>
        </value>
      </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]/apparelColor</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]/apparelColor</xpath>
      <value>
        <apparelColor>(39,36,31)</apparelColor>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Empire_Fighter_Cataphract"]</xpath>
      <value>
        <apparelColor>(39,36,31)</apparelColor>
      </value>
    </nomatch>
  </Operation>

</Patch>