    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="VFEE_Empire_Fighter_Absolver"]/apparelRequired</xpath>
      <value>
        <apparelRequired>
          <li>KRC_RabbitCaptainHelmet</li>
          <li>KRC_RabbitCaptainArmor</li>
          <li>KRC_RcFatigues</li>
        </apparelRequired>
      </value>
    </match>
