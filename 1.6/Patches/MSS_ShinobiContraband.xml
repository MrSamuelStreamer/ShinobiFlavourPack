<?xml version="1.0" encoding="UTF-8"?>
<Patch>
<!-- Stealth -->
<Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimTek StealthBelt</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Apparel_StealthBelt"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>5</intelCost>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Apparel_StealthBelt_MKII"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>2</intelCost>
              <useCriticalIntel>true</useCriticalIntel>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <!-- Exosuits -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[RH2] Metal Gear Solid</li>
    </mods>
    <match Class="PatchOperationSequence">
