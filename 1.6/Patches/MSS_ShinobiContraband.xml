        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="RHApparel_ExoHelmet_Raiden"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>2</intelCost>
              <useCriticalIntel>true</useCriticalIntel>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="RHApparel_ExoSuit_Raiden"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>5</intelCost>
              <useCriticalIntel>true</useCriticalIntel>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="RHApparel_ExoHelmet_GrayFox"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>3</intelCost>
              <useCriticalIntel>true</useCriticalIntel>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="RHApparel_ExoSuit_GrayFox"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>6</intelCost>
              <useCriticalIntel>true</useCriticalIntel>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <!-- Medical -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="MedicineUltratech"]</xpath>
    <value>
      <li Class="VFED.ContrabandExtension">
        <category>MSS_Shinobi</category>
		    <intelCost>2</intelCost>
        <useCriticalIntel>true</useCriticalIntel>
        <countMult>5</countMult>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Det's Battle Meds</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="DV_AdrenalineShot"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>5</intelCost>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="StimpackIndustrial"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>5</intelCost>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="StimpackUltratech"]</xpath>
          <value>
            <li Class="VFED.ContrabandExtension">
              <category>MSS_Shinobi</category>
              <intelCost>5</intelCost>
              <useCriticalIntel>true</useCriticalIntel>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <!-- Tech Prints -->
  <Operation Class="PatchOperationAdd">
		<xpath>/Defs/RoyalTitleDef[defName="Consul"]</xpath>
		<value>
			<rewards>
				<Techprint_MSS_Research_Neutroamine>1</Techprint_MSS_Research_Neutroamine>
			</rewards>
		</value>
	</Operation>
</Patch>