<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="PatchOperationConditional">
                <xpath>Defs/PawnKindDef[@Name="VFEE_DeserterBase"]/apparelTags</xpath>
                <nomatch Class="PatchOperationAdd">
                    <xpath>Defs/PawnKindDef[@Name="VFEE_DeserterBase"]</xpath>
                    <value>
                        <apparelTags />
                    </value>
                </nomatch>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/PawnKindDef[@Name="VFEE_DeserterBase"]/apparelTags</xpath>
                <value>
                    <apparelTags>
                        <li>Apparel_NinjaBasic</li>
                        <li>Apparel_NinjaShinobi</li>
                        <li>Apparel_NeoSamurai</li>
                    </apparelTags>
                </value>
            </li>
            <li Class="PatchOperationAttributeSet">
                <xpath>Defs/PawnKindDef[@Name="VFEE_DeserterBase"]/apparelTags</xpath>
                <attribute>Inherit</attribute>
                <value>False</value>
            </li>
        </operations>
    </Operation>

    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="PatchOperationConditional">
                <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/apparelRequired</xpath>
                <nomatch Class="PatchOperationAdd">
                    <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]</xpath>
                    <value>
                        <apparelRequired />
                    </value>
                </nomatch>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/apparelRequired</xpath>
                <value>
                    <apparelRequired>
                        <li>RHApparel_ExoSuit_GrayFox</li>
                        <li>US_MatrixGlasses</li>
                        <li>TA_KatanaBelt</li>
                        <li>HS_Edo_Cloak</li>
                    </apparelRequired>
                </value>
            </li>
            <li Class="PatchOperationAttributeSet">
                <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/apparelRequired</xpath>
                <attribute>Inherit</attribute>
                <value>False</value>
            </li>
        </operations>
    </Operation>

    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="PatchOperationConditional">
                <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/weaponTags</xpath>
                <nomatch Class="PatchOperationAdd">
                    <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]</xpath>
                    <value>
                        <weaponTags />
                    </value>
                </nomatch>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/weaponTags</xpath>
                <value>
                    <weaponTags>
                        <li>RH2_HFKatana</li>
                        <li>HSSpecialMelee</li>
                        <li>HSSamuraiClanforgedMelee</li>
                        <li>NinjaRangedBasic</li>
                        <li>NeoSamuraiRanged</li>
                    </weaponTags>
                </value>
            </li>
            <li Class="PatchOperationAttributeSet">
                <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/weaponTags</xpath>
                <attribute>Inherit</attribute>
                <value>False</value>
            </li>
        </operations>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/apparelColor</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]/apparelColor</xpath>
            <value>
                <apparelColor>(69,69,69)</apparelColor>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/PawnKindDef[defName="VFEE_Deserter"]</xpath>
            <value>
                <apparelColor>(69,69,69)</apparelColor>
            </value>
        </nomatch>
    </Operation>
</Patch>
