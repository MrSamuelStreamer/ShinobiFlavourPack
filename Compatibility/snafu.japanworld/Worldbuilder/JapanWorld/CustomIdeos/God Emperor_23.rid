	<ideo>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Boccocarro</place>
			<deities />
		</foundation>
		<name>God Emperor</name>
		<adjective>divine</adjective>
		<memberName>Servant</memberName>
		<leaderTitleMale>Inclusive Director</leaderTitleMale>
		<leaderTitleFemale>Inclusive Director</leaderTitleFemale>
		<description>It seems that the teachings of the ancient Taoist and Libertarian scholars had a lot of truth to teach us. We must recognize that all religions contain varying elements of a common truth, and respect all beliefs accordingly.</description>
		<descriptionTemplate>It seems that the teachings of the ancient Taoist and Libertarian scholars had a lot of truth to teach us. We must recognize that all religions contain varying elements of a common truth, and respect all beliefs accordingly.</descriptionTemplate>
		<culture>Astropolitan</culture>
		<iconDef>StarsE</iconDef>
		<colorDef>DarkGreen</colorDef>
		<primaryFactionColor>RGBA(0.000, 0.737, 0.847, 1.000)</primaryFactionColor>
		<memes>
			<li>VME_Structure_Omnism</li>
			<li>VME_GodEmperor</li>
			<li>VME_Aristocratic</li>
			<li>VME_Elders</li>
		</memes>
		<precepts>
			<li>
				<name>dumb labor</name>
				<def>VME_DumbLabor_Horrible</def>
				<ID>1394</ID>
				<randomSeed>-1880641605</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
			<li>
				<name>elders</name>
				<def>VME_Elders_Holy</def>
				<ID>1395</ID>
				<randomSeed>-1376972918</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
			<li>
				<name>leader divinity</name>
				<def>VME_Leader_Godlike</def>
				<ID>1396</ID>
				<randomSeed>411983151</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
			<li Class="Precept_Ritual">
				<name>Requiem of God Emperor</name>
				<def>AM_CremateFuneral</def>
				<ID>1397</ID>
				<randomSeed>-2109993489</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<nameMaker>NamerRitualFuneral</nameMaker>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witnesss {RITUAL_labelDef} return to dust.</ritualExpectedDesc>
				<playsIdeoMusic>True</playsIdeoMusic>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>AM_CremateFuneralPattern</sourcePattern>
				<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_FuneralThingExtended">
					<def>AM_FuneralExtendedCremate</def>
					<parent>Precept_1397</parent>
					<filters>
						<li Class="AlphaMemes.RitualObligationTargetWorker_FuneralThingNeedsPower">
							<def>AM_FuneralTargetCremate</def>
							<parent>Precept_1397</parent>
						</li>
						<li Class="AlphaMemes.RitualObligationTargetWorker_HaveRequiredStuff">
							<def>AM_FuneralTargetCremateUrnStuff</def>
							<parent>Precept_1397</parent>
						</li>
					</filters>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
				<behavior Class="AlphaMemes.RitualBehaviorWorker_FuneralFramework">
					<def>AM_CremateFuneralBehavior</def>
					<corpse>null</corpse>
					<effecterpawn>null</effecterpawn>
					<spawnEffectThings />
				</behavior>
				<triggers>
					<li Class="RitualObligationTrigger_MemberDied">
						<mustBePlayerIdeo>True</mustBePlayerIdeo>
					</li>
				</triggers>
				<outcomeEffect Class="AlphaMemes.RitualOutcomeEffectWorker_FuneralFramework">
					<def>AM_CremateFuneralOutcome</def>
					<compDatas>
						<li IsNull="True" />
						<li Class="RitualOutcomeComp_DataThingPresence">
							<presentForTicks>
								<keys />
								<values />
							</presentForTicks>
						</li>
						<li IsNull="True" />
						<li IsNull="True" />
					</compDatas>
				</outcomeEffect>
				<layerWhitelist IsNull="True" />
				<layerBlacklist IsNull="True" />
			</li>
			<li Class="Precept_Ritual">
				<name>funeral (no corpse)</name>
				<def>AM_FuneralNoCorpse</def>
				<ID>1398</ID>
				<randomSeed>343676058</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
				<playsIdeoMusic>True</playsIdeoMusic>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
				<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
					<def>AnyEmptyGrave</def>
					<parent>Precept_1398</parent>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
				<behavior Class="RitualBehaviorWorker_Funeral">
					<def>Funeral</def>
				</behavior>
				<triggers>
					<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
						<mustBePlayerIdeo>True</mustBePlayerIdeo>
					</li>
				</triggers>
				<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
					<def>AttendedFuneralNoCorpse</def>
					<compDatas>
						<li IsNull="True" />
						<li Class="RitualOutcomeComp_DataThingPresence">
							<presentForTicks>
								<keys />
								<values />
							</presentForTicks>
						</li>
						<li IsNull="True" />
					</compDatas>
				</outcomeEffect>
				<layerWhitelist IsNull="True" />
				<layerBlacklist IsNull="True" />
			</li>
			<li>
				<name>power</name>
				<def>VME_Power_Exalted</def>
				<ID>1399</ID>
				<randomSeed>-1903171553</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
