	<ideo>
		<overriddenWorshipRoomLabel>Shrine</overriddenWorshipRoomLabel>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Ilwaba</place>
			<deities>
				<li>
					<name>Susanoo</name>
					<type>God of Storms</type>
					<gender>Male</gender>
					<iconPath>UI/Deities/DeityGeneric</iconPath>
					<relatedMeme>AM_VampireHunting</relatedMeme>
				</li>
				<li>
					<name>Bishamonten</name>
					<type>God of Warriors</type>
					<gender>Female</gender>
					<iconPath>UI/Deities/DeityGeneric</iconPath>
					<relatedMeme>Proselytizer</relatedMeme>
				</li>
				<li>
					<name>Hachiman</name>
					<type>God of War</type>
					<gender>Female</gender>
					<iconPath>UI/Deities/DeityGeneric</iconPath>
					<relatedMeme>Structure_OriginShinto</relatedMeme>
				</li>
			</deities>
		</foundation>
		<name>Purists</name>
		<adjective>Purists</adjective>
		<memberName>Purists</memberName>
		<leaderTitleMale>Head Priest</leaderTitleMale>
		<leaderTitleFemale>Head Priest</leaderTitleFemale>
		<description>Though loyal to the Lotus Emperor, the &lt;color=#D09B61FF&gt;Purists&lt;/color&gt; disavow any form of technology modification. All body modification is found abhorrent and unforgivable, and the &lt;color=#D09B61FF&gt;Purists&lt;/color&gt; defy the Emperor’s will by spreading their cause where they can. The Emperor relies on the Purists for upholding all other religious matters, and Purists need the Emperor’s protection to match their cyber-enhanced enemies, so neither side can be rid of the other.</description>
		<descriptionLocked>True</descriptionLocked>
		<culture>HSEdoClanCulture</culture>
		<iconDef>NatureE</iconDef>
		<colorDef>kathanon_CraftWithColor_16765440</colorDef>
		<memes>
			<li>Structure_OriginShinto</li>
			<li>FleshPurity</li>
			<li>PainIsVirtue</li>
			<li>VME_ViolentConversion</li>
			<li>VME_ExaltedPriesthood</li>
			<li>VME_Light</li>
		</memes>
		<precepts>
			<li>
				<name>slavery</name>
				<def>Slavery_Honorable</def>
				<ID>6663</ID>
				<randomSeed>-1343612626</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
			<li>
				<name>body modification</name>
				<def>BodyMod_Abhorrent</def>
				<ID>6664</ID>
				<randomSeed>-1926525983</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
			<li>
				<name>drug use</name>
				<def>DrugUse_Prohibited</def>
				<ID>6665</ID>
				<randomSeed>-1875837592</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
			<li>
				<name>combat in darkness</name>
				<def>VME_DarknessCombat_Despised</def>
				<ID>6666</ID>
				<randomSeed>2097131014</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
			</li>
			<li Class="Precept_Ritual">
				<name>Funeral of Susanoo</name>
				<def>AM_BlastOffFuneral</def>
				<ID>6667</ID>
				<randomSeed>1220695060</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<nameMaker>NamerRitualFuneral</nameMaker>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witness their friend return to space.</ritualExpectedDesc>
				<playsIdeoMusic>True</playsIdeoMusic>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>AM_BlastOffFuneralPattern</sourcePattern>
				<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_Launchable">
					<def>AM_FuneralBlastOff</def>
					<parent>Precept_6667</parent>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
				<behavior Class="AlphaMemes.RitualBehaviorWorker_FuneralFramework">
					<def>AM_BlastOffBehavior</def>
					<corpse>null</corpse>
					<effecterpawn>null</effecterpawn>
					<spawnEffectThings />
				</behavior>
				<triggers>
					<li Class="RitualObligationTrigger_MemberDied">
						<mustBePlayerIdeo>True</mustBePlayerIdeo>
					</li>
				</triggers>
				<outcomeEffect Class="AlphaMemes.RitualOutcomeEffectWorker_FuneralBlastOff">
					<def>AM_BlastOffFuneralOutcome</def>
					<compDatas>
						<li IsNull="True" />
						<li Class="RitualOutcomeComp_DataThingPresence">
							<presentForTicks>
								<keys />
								<values />
							</presentForTicks>
						</li>
						<li IsNull="True" />
					</compDatas>
				</outcomeEffect>
				<layerWhitelist IsNull="True" />
				<layerBlacklist IsNull="True" />
			</li>
			<li Class="Precept_Ritual">
				<name>funeral (no corpse)</name>
				<def>AM_FuneralNoCorpse</def>
				<ID>6668</ID>
				<randomSeed>-1673741914</randomSeed>
				<usesDefiniteArticle>True</usesDefiniteArticle>
				<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
				<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
				<playsIdeoMusic>True</playsIdeoMusic>
				<generatedAttachedReward>True</generatedAttachedReward>
				<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
				<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
					<def>AnyEmptyGrave</def>
					<parent>Precept_6668</parent>
				</obligationTargetFilter>
				<targetFilter IsNull="True" />
				<behavior Class="RitualBehaviorWorker_Funeral">
					<def>Funeral</def>
				</behavior>
				<triggers>
					<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
						<mustBePlayerIdeo>True</mustBePlayerIdeo>
					</li>
				</triggers>
				<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
					<def>AttendedFuneralNoCorpse</def>
					<compDatas>
						<li IsNull="True" />
						<li Class="RitualOutcomeComp_DataThingPresence">
							<presentForTicks>
								<keys />
								<values />
							</presentForTicks>
						</li>
						<li IsNull="True" />
					</compDatas>
				</outcomeEffect>
				<layerWhitelist IsNull="True" />
				<layerBlacklist IsNull="True" />
			</li>
