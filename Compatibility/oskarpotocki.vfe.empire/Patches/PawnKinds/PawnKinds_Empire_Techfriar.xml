                </value>
            </li>
            <li Class="PatchOperationAttributeSet">
                <xpath>Defs/PawnKindDef[defName="VFEE_Empire_Royal_Techfriar"]/apparelRequired</xpath>
                <attribute>Inherit</attribute>
                <value>False</value>
