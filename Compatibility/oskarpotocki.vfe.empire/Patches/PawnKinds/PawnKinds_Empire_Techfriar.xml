        <xpath>Defs/PawnKindDef[defName="VFEE_Empire_Royal_Techfriar"]/apparelColor</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/PawnKindDef[defName="VFEE_Empire_Royal_Techfriar"]/apparelColor</xpath>
            <value>
